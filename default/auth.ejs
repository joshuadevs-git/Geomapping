<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vulnerable Sector Information System - Log In</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" type="text/css" href="\assets\css\login.css">
    
</head>
<body>


<div class="page">

    <!-- Top Nav (right side only) -->
   

    <!-- Left: Login Form -->
    <div class="left-panel">
        <div class="brand">
            <div class="brand-icon"><i class="fas fa-building"></i></div>
            <div>
                <div class="brand-name"></div>
                <div class="brand-sub">Municipality of E.B. Magalona</div>
            </div>
        </div>

        <div class="avatar-wrap">
            <div class="avatar"><i class="fas fa-user"></i></div>
        </div>

        <form method="POST" action="/login" id="loginForm">
            <input type="hidden" name="role" id="selected-role" value="user">

            <div class="field">
                <i class="fas fa-user field-icon"></i>
                <input type="email" class="field-input" name="email" id="email" placeholder="Username" required autocomplete="email">
            </div>

            <div class="field">
                <i class="fas fa-lock field-icon"></i>
                <input type="password" class="field-input" name="password" id="password" placeholder="Password" required autocomplete="current-password">
            </div>

            <button type="submit" class="btn-login">Login</button>

            <div class="form-footer">
                <label class="remember">
                    <input type="checkbox" name="remember"> Remember me
                </label>
                <a class="forgot" href="#">Forgot password?</a>
            </div>
        </form>

        <div class="dots-nav">
            <div class="d-dot active"></div>
            <div class="d-dot"></div>
            <div class="d-dot"></div>
        </div>
    </div>

    <!-- Right: Welcome + Fluid Blobs -->
    <div class="right-panel">
        <div class="fluid-bg"></div>
        <div class="blob blob1"></div>
        <div class="blob blob2"></div>
        <div class="blob blob3"></div>

        <div class="welcome-text">
            <h1>Welcome.</h1>
            <p>Delivering fair, responsive, and caring services for PWDs, senior citizens, and all vulnerable sectors of our community.</p>
            
        </div>
    </div>

</div>

<!-- Scripts -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js"></script>
<script src="/assets/js/auth.js"></script>

</body>
</html>