									<div class="admin-container" style="padding: 1rem 1.5rem;">
										<h4 class="mb-3">Audit logs</h4>
										<p class="text-muted mb-4">Field-level edits from PWD and senior citizen records, plus successful sign-ins (who logged in and when).</p>

										<div class="mb-5">
											<h5 class="mb-3"><i class="feather icon-users mr-1"></i> PWD edit logs</h5>
											<div class="table-responsive">
												<table class="table table-striped table-bordered table-hover">
													<thead class="thead-light">
														<tr>
															<th>Record</th>
															<th>PWD ID</th>
															<th>Field</th>
															<th>Previous value</th>
															<th>New value</th>
															<th>Edited by</th>
															<th>Edited at</th>
														</tr>
													</thead>
													<tbody>
														<% if (typeof pwdLogs !== 'undefined' && pwdLogs && pwdLogs.length) { %>
															<% pwdLogs.forEach(function(row) { %>
																<tr>
																	<td><%= row.record_name && row.record_name.trim() ? row.record_name : '—' %></td>
																	<td><%= row.pwd_id != null ? row.pwd_id : '—' %></td>
																	<td><%= row.field != null ? row.field : '—' %></td>
																	<td style="max-width:220px;word-break:break-word;"><%= row.old_value != null && row.old_value !== '' ? row.old_value : '—' %></td>
																	<td style="max-width:220px;word-break:break-word;"><%= row.new_value != null && row.new_value !== '' ? row.new_value : '—' %></td>
																	<td><%= row.edited_by != null && row.edited_by !== '' ? row.edited_by : '—' %></td>
																	<td><% if (row.edited_at) { %><%= new Date(row.edited_at).toLocaleString() %><% } else { %>—<% } %></td>
																</tr>
															<% }); %>
														<% } else { %>
															<tr><td colspan="7" class="text-center text-muted">No PWD edit logs yet.</td></tr>
														<% } %>
													</tbody>
												</table>
											</div>
										</div>

										<div>
											<h5 class="mb-3"><i class="feather icon-user mr-1"></i> Senior citizen edit logs</h5>
											<div class="table-responsive">
												<table class="table table-striped table-bordered table-hover">
													<thead class="thead-light">
														<tr>
															<th>Record</th>
															<th>Senior ID</th>
															<th>Field</th>
															<th>Previous value</th>
															<th>New value</th>
															<th>Edited by</th>
															<th>Edited at</th>
														</tr>
													</thead>
													<tbody>
														<% if (typeof seniorLogs !== 'undefined' && seniorLogs && seniorLogs.length) { %>
															<% seniorLogs.forEach(function(row) { %>
																<tr>
																	<td><%= row.record_name && row.record_name.trim() ? row.record_name : '—' %></td>
																	<td><%= row.senior_id != null ? row.senior_id : '—' %></td>
																	<td><%= row.field != null ? row.field : '—' %></td>
																	<td style="max-width:220px;word-break:break-word;"><%= row.old_value != null && row.old_value !== '' ? row.old_value : '—' %></td>
																	<td style="max-width:220px;word-break:break-word;"><%= row.new_value != null && row.new_value !== '' ? row.new_value : '—' %></td>
																	<td><%= row.edited_by != null && row.edited_by !== '' ? row.edited_by : '—' %></td>
																	<td><% if (row.edited_at) { %><%= new Date(row.edited_at).toLocaleString() %><% } else { %>—<% } %></td>
																</tr>
															<% }); %>
														<% } else { %>
															<tr><td colspan="7" class="text-center text-muted">No senior citizen edit logs yet.</td></tr>
														<% } %>
													</tbody>
												</table>
											</div>
										</div>

										<div class="mb-5">
											<h5 class="mb-3"><i class="feather icon-log-in mr-1"></i> Login logs</h5>
											<div class="table-responsive">
												<table class="table table-striped table-bordered table-hover">
													<thead class="thead-light">
														<tr>
															<th>User ID</th>
															<th>Name</th>
															<th>Email</th>
															<th>Role</th>
															<th>Account status</th>
															<th>Logged in at</th>
														</tr>
													</thead>
													<tbody>
														<% if (typeof loginLogs !== 'undefined' && loginLogs && loginLogs.length) { %>
															<% loginLogs.forEach(function(row) { %>
																<tr>
																	<td><%= row.user_id != null ? row.user_id : '—' %></td>
																	<td><%= row.user_name != null && String(row.user_name).trim() !== '' ? row.user_name : '—' %></td>
																	<td><%= row.user_email != null && row.user_email !== '' ? row.user_email : '—' %></td>
																	<td><%= row.user_role != null && row.user_role !== '' ? row.user_role : '—' %></td>
																	<td><%= row.user_status != null && row.user_status !== '' ? row.user_status : '—' %></td>
																	<td><% if (row.created_at) { %><%= new Date(row.created_at).toLocaleString() %><% } else { %>—<% } %></td>
																</tr>
															<% }); %>
														<% } else { %>
															<tr><td colspan="6" class="text-center text-muted">No login logs yet.</td></tr>
														<% } %>
													</tbody>
												</table>
											</div>
										</div>
									</div>

									<!-- latest activity end -->
								  </div>
							</div>
